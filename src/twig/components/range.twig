<div class="us-range">
    <div class="us-range__price-input">
        <input class="us-range__input-min" type="number" value="{{ min }}">
        <div class="us-range__separator"></div>
        <input class="us-range__input-max" type="number" value="{{ max }}">
    </div>

    <div class="us-range__range-input">
        <div class="us-range__slider"><div class="us-range__progress" style="left: 0%; right: 0%"></div></div>
        <input class="us-range__range-min" type="range" min="{{ min }}" max="{{ max }}" value="{{ min }}" step="100">
        <input class="us-range__range-max" type="range" min="{{ min }}" max="{{ max }}" value="{{ max }}" step="100">
    </div>
</div>
