{% extends '@layouts/slider.twig' %}

{% set class = 'us-slider-categories' %}
{% set swiper_options = {
    "slidesPerView": 3,
    "spaceBetween": 20,
    "breakpoints": {
        769: { "slidesPerView": 4 },
        993: { "slidesPerView": 5 },
    }
} %}

{% block slides %}
    {% for category in categories %}
        <div class="swiper-slide us-slider-categories__slide">
            <a class="us-slider-categories__link" href="{{ category.link }}">
                {% if not category.image.src %}
                    <img class="us-slider-categories__img" src="/src/images/pictures/placeholder-image.jpg" alt="{{ category.image.alt }}">
                {% else %}
                    <img class="us-slider-categories__img" src="{{ category.image.src }}" alt="{{ category.image.alt }}">
                {% endif %}
                <span class="us-slider-categories__title">{{ category.title }}</span>
            </a>
        </div>
    {% endfor %}
{% endblock %}
