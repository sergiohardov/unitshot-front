<div class="us-slider-logo-images">

    <div class="swiper">
        <div class="swiper-wrapper">
            {% for logo in logotypes %}
                <div class="swiper-slide us-slider-logo-images__slide">
                    <a class="us-slider-logo-images__slide-link" href="{{ logo.link }}">
                        <img class="us-slider-logo-images__slide-img" src="{{ logo.image.src }}" alt="{{ logo.image.alt }}">
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="us-slider-logo-images__pagination"></div>
</div>
