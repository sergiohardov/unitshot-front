<div class="us-client-logos" x-data="{ expanded: false }">
    <div class="us-container">
        <div class="us-client-logos__inner">
            {% include '@components/page-title.twig' with {
                'title': title
            } %}

            {% if clients %}
                <ul class="us-client-logos__list us-client-logos__list--collapsed" x-bind:class="{ 'us-client-logos__list--collapsed': !expanded }">
                    {% for client in clients %}
                        <li class="us-client-logos__item">
                            <img src="{{ client.src }}" alt="{{ client.alt }}">
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

            <div class="us-client-logos__more {% if clients|length > 24 %} us-client-logos__more--24 {% endif %} {% if clients|length > 21 %} us-client-logos__more--21 {% endif %}" x-show="!expanded">
                <button class="us-client-logos__more-btn" type="button" x-on:click="expanded = true">Розгорнути</button>
            </div>
        </div>
    </div>
</div>
