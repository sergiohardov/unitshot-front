<div class="us-feedback-info {{ class }}">
    <div class="us-container">
        <div class="us-feedback-info__inner">
            {% include '@components/page-title.twig' with {
                'class': '',
                'title': title
            } %}

            {% if description %}
                <div class="us-feedback-info__description">{{ description|raw }}</div>
            {% endif %}

            <div class="us-feedback-info__contacts">
                {% if socials %}
                    <div class="us-feedback-info__contacts-content">
                        <span class="us-feedback-info__contacts-title">Написати нам:</span>
                        <div class="us-feedback-info__socials">
                            {% for social in socials %}
                                <a class="us-feedback-info__socials-link" href="{{ social.link }}">
                                    <img src="/src/images/icons/social-{{ social.icon }}.svg" alt="{{ social.icon }}">
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                {% if numbers %}
                    <div class="us-feedback-info__contacts-content">
                        <span class="us-feedback-info__contacts-title">Подзвонити:</span>
                        <div class="us-feedback-info__numbers">
                            {% for number in numbers %}
                                {% include '@components/phone-number.twig' with {
                                    'class': '',
                                    'number': number
                                } %}
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}

                <div class="us-feedback-info__contacts-content" x-data>
                    <span class="us-feedback-info__contacts-title">Замовити дзвінок:</span>
                    {% include '@components/button-square.twig' with {
                        'version': 'v2',
                        'text': 'Безкоштовна констультація',
                        'class': 'us-feedback-info__contacts-btn',
                        'x_click': "$store.ModalStore.open('us-modal-call')"
                    } %}
                </div>
            </div>
        </div>
    </div>
</div>
