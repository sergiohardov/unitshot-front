<header class="us-header">
    <div class="us-header__line">
        <div class="us-container">
            <div class="us-header__line__inner">
                <div class="us-header__line__top">
                    {% if logo.src %}
                        <a href="{{ home_url() }}" class="us-header__line__logo">
                            <img src="{{ logo.src }}" alt="" class="{{ logo.alt }}">
                        </a>
                    {% endif %}

                    <div class="us-header__line__top-right">
                        {% if settings %}
                            <div class="us-header__line__settings">
                                {% for setting in settings %}
                                    <div class="us-header__line__settings__item">
                                        {% for item in setting %}
                                            <a href="{{ item.link }}" class="us-header__line__settings__item-title {% if item.is_current %} us-header__line__settings__item-title--current {% endif %}">{{ item.title }}</a>
                                        {% endfor %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="us-header__line__buttons">
                            {% include '@components/button-round.twig' with {
                                'version': 'v0',
                                'icon': 'burger',
                                'class': 'us-header__line__buttons__item us-header__line__buttons__item--burger'
                            } %}

                            {% include '@components/button-round.twig' with {
                                'version': 'v0',
                                'icon': 'search',
                                'class': 'us-header__line__buttons__item us-header__line__buttons__item--search'
                            } %}

                            {% include '@components/button-round.twig' with {
                                'version': 'v0',
                                'icon': 'cart',
                                'class': 'us-header__line__buttons__item us-header__line__buttons__item--cart'
                            } %}
                        </div>
                    </div>
                </div>

                <div class="us-header__line__bottom">
                    <nav class="us-header__line__nav">
                        <button class="us-header__line__nav__burger"></button>

                        {% if top_menu %}
                        <ul class="us-header__line__menu">
                            {% for item in top_menu %}
                                <li class="us-header__line__menu__item"><a href="{{ item.link }}">{{ item.title }}</a></li>
                            {% endfor %}
                        </ul>
                        {% endif %}
                    </nav>

                    <div class="us-header__line__number">
                        {% include '@components/phone-number.twig' with {
                            'number': number,
                            'class': 'us-header__line__number__phone'
                        } %}

                        <button class="us-header__line__number__arrow"></button>

                        <div class="us-header__line__number__menu">
                            {% if socials %}
                                <ul class="us-header__line__number__list">
                                    {% for social in socials %}
                                        <li>
                                            <a class="us-header__line__number__list-item" href="{{ social.link }}">
                                                {{ svg_icon(social.icon) }}
                                                <span>{{ social.title }}</span>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="us-header__menu">
        <div class="us-container">
            <div class="us-header__menu__inner">
                <div class="us-header__menu__categories">
                    {% if category_menu.categories %}
                        <ul class="us-header__menu__categories-list">
                            {% for item in category_menu.categories %}
                                <li class="us-header__menu__categories-item">
                                    <a class="us-header__menu__categories-link {% if item.is_current %} us-header__menu__categories-link--current {% endif %}" href="{{ item.link }}">{{ item.title }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
                <div class="us-header__menu__subcategories">
                    {% if category_menu.subcategories %}
                        <ul class="us-header__menu__subcategories-list">
                            {% for item in category_menu.subcategories %}
                                <li class="us-header__menu__subcategories-item">
                                    <a class="us-header__menu__subcategories-link {% if item.is_current %} us-header__menu__subcategories-link--current {% endif %}" href="{{ item.link }}">{{ item.title }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </div>
                <div class="us-header__menu__brands">
                    {% if category_menu.brands %}
                    <ul class="us-header__menu__brands-list">
                        {% for item in category_menu.brands %}
                            <li class="us-header__menu__brands-item">
                                <a class="us-header__menu__brands-link" href="{{ item.link }}">
                                    <img src="{{ item.image.src }}" alt="{{ item.image.alt }}">
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</header>
