<header class="us-header">
    <div class="us-container">
        <div class="us-header__inner">
            <div class="us-header__top">
                {% if logo.src and home_url %}
                    <a href="{{ home_url }}" class="us-header__logo">
                        <img src="{{ logo.src }}" alt="" class="{{ logo.alt }}">
                    </a>
                {% endif %}

               <div class="us-header__top-right">
                   <div class="us-header__settings">
                       <div class="us-header__settings-item us-header__currency">
                           <a href="#" class="us-header__settings-item-title">UAH</a>
                           <a href="#" class="us-header__settings-item-title us-header__settings-item-title-current">EUR</a>
                       </div>

                       <div class="us-header__settings-item us-header__lang">
                           <a href="#" class="us-header__settings-item-title">UA</a>
                           <a href="#" class="us-header__settings-item-title us-header__settings-item-title--current">RU</a>
                       </div>
                   </div>

                   <div class="us-header__buttons">
                       <button class="us-header__buttons-item us-header__buttons-item--burger">
                           {{ svg_icon('burger')|raw }}
                       </button>

                       <button class="us-header__buttons-item us-header__buttons-item--search">
                           {{ svg_icon('search')|raw }}
                       </button>

                       <button class="us-header__buttons-item us-header__buttons-item--cart">
                           {{ svg_icon('cart')|raw }}
                       </button>
                   </div>
               </div>
            </div>

            <div class="us-header__bottom">
                <nav class="us-header__nav">
                    <button class="us-header__burger">
                        <img src="/src/images/icons/burger.svg" alt="burger">
                    </button>

                    <ul class="us-header__menu">
                        <li class="us-header__menu-item"><a href="#">Кавомашини</a></li>
                        <li class="us-header__menu-item"><a href="#">Кавомашини</a></li>
                        <li class="us-header__menu-item"><a href="#">Доставка та оплата</a></li>
                        <li class="us-header__menu-item"><a href="#">Сервіс</a></li>
                        <li class="us-header__menu-item"><a href="#">Про нас</a></li>
                    </ul>
                </nav>

                <div class="us-header__number">
                    {% include '@components/phone-number.twig' with {
                        'number': '+380731111111'
                    } %}
                </div>
            </div>
        </div>
    </div>
</header>
