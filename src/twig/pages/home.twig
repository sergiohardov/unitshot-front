{% extends '@layouts/base.twig' %}

{% block content %}
    {% include '@blocks/brand-logos.twig' with {
        'brands': brand_logos.brands,
    } %}

    {% include '@blocks/popular-products.twig' with {
        'title': popular_products.title,
        'products': popular_products.products
    } %}

    {% include '@blocks/category-showcase.twig' with {
        'title': category_showcase_1.title,
        'categories': category_showcase_1.categories,
        'brands': category_showcase_1.brands,
        'products': category_showcase_1.products,
    } %}

    {% include '@blocks/category-showcase.twig' with {
        'title': category_showcase_2.title,
        'categories': category_showcase_2.categories,
        'brands': category_showcase_2.brands,
        'products': category_showcase_2.products,
    } %}

    {% include '@blocks/category-links.twig' with {
        'title': category_links.title,
        'categories': category_links.categories
    } %}

    {% include '@blocks/text-image.twig' with {
        'title': text_image.title,
        'description': text_image.description,
        'image': text_image.image
    } %}
{% endblock %}

