{% extends '@layouts/demo.twig' %}

{% block content %}
    <style>
        /* inner numeric list */
        ol {
            list-style-type: none;
            counter-reset: item;
            margin: 0;
            padding: 0;
            padding-left: 40px;
        }

        ol > li {
            position: relative;
            counter-increment: item;
            margin-bottom: 0.6em;
            padding: 10px 0;
        }

        ol > li:before {
            left: -40px;
            position: absolute;
            content: counters(item, ".") ". ";
        }

        li ol > li {
            margin: 0;
        }

        li ol > li:before {
            content: counters(item, ".") " ";
        }
    </style>

    <div class="us-container">
        <ol style="margin: 20px 0;">
            <li>
                <span>Colors</span>
                <ol style="display: flex; gap: 10px;flex-direction: column;">
                    {% for item in colors %}
                        <li style="display:flex;align-items: center;gap: 20px;">
                            <span style="background-color: var({{ item }}); display: inline-block;height: 30px; width: 30px; border: 1px solid black"></span>
                            <span>:</span>
                            <span>{{ item }}</span>
                        </li>
                    {% endfor %}
                </ol>
            </li>

            <li>
                <span>Fonts</span>
                <ol style="display: flex; gap: 10px;flex-direction: column;">
                    {% for item in fonts %}
                        <li><span>{{ item.name }} : {{ item.var }}</span>
                            <ol>
                                {% for weight in item.weights %}
                                    <li style="display:flex;align-items: center;gap: 20px;">
                                        <span style="font-family: var({{ item.var }}); font-size: 20px; font-weight: {{ weight }}; height: 100px; width: 200px; border: 1px solid black;display:flex;align-items: center; justify-content: center">Example Text</span>
                                        <span>:</span>
                                        <span>{{ weight }}</span>
                                    </li>
                                {% endfor %}
                            </ol>
                        </li>

                    {% endfor %}
                </ol>
            </li>

            <li>
                <span>Classes</span>
                <ol>
                    <li>
                        <span>Container: .us-container</span>
                        <div class="us-container">
                            <div style="display: flex; align-items:center; justify-content: center; height: 50px; background-color: var(--unitshot-accent-pink); margin: 0 -15px;">
                                <p>1290px/auto</p>
                            </div>
                        </div>
                    </li>

                    <li>
                        <span>Title: .us-title-h1;.us-title-h2</span>
                        <div>
                            <h1 class="us-title-h1">h1 Example</h1>
                            <h2 class="us-title-h2">h2 Example</h2>
                        </div>
                    </li>
                </ol>
            </li>

            <li>
                <span>Components</span>
                <ol>
                    {% if components %}
                        {% for component in components %}
                            <li><a href="/components/{{ component }}.html"
                                   style="color: var(--unitshot-accent-pink); text-decoration: underline">{{ component }}</a>
                            </li>
                        {% endfor %}
                    {% endif %}


                    <li>
                        <span class="ui-title">Modals</span>
                        <div class="ui-content" style="display: flex; gap: 10px; flex-wrap: wrap;">
                            {% include '@components/button-square.twig' with {
                                'version': 'v2',
                                'text': 'Modal Add Cart',
                                'data': 'data-us-modal-id="us-modal-add-cart"',
                                'type': false,
                                'id': ""
                            } %}
                            {% include '@components/button-square.twig' with {
                                'version': 'v2',
                                'text': 'Modal Remove Cart',
                                'data': 'data-us-modal-id="us-modal-remove-cart"',
                                'type': false,
                                'id': ""
                            } %}
                            {% include '@components/button-square.twig' with {
                                'version': 'v2',
                                'text': 'Modal Lang',
                                'data': 'data-us-modal-id="us-modal-lang"',
                                'type': false,
                                'id': ""
                            } %}
                            {% include '@components/button-square.twig' with {
                                'version': 'v2',
                                'text': 'Modal Call',
                                'data': 'data-us-modal-id="us-modal-call"',
                                'type': false,
                                'id': ""
                            } %}
                        </div>
                        {% include '@components/modal-add-cart.twig' with {
                            'id': 'us-modal-add-cart',
                            'class': 'us-modal-add-cart',
                            'title': 'Товар додано до кошика',
                        } %}

                        {% include '@components/modal-remove-cart.twig' with {
                            'id': 'us-modal-remove-cart',
                            'class': 'us-modal-remove-cart',
                            'title': 'Товар видалено з кошика',
                        } %}
                        
                        {% include '@components/modal-lang.twig' with {
                            'id': 'us-modal-lang',
                            'class': 'us-modal-lang',
                            'title': 'Чи бажаєте переглядати сайт українською мовою?',
                            'buttons': {
                                'secondary': {
                                    'text': 'Ні',
                                },
                                'primary': {
                                    'text': 'Так',
                                }
                            }
                        } %}

                        {% include '@components/modal-call.twig' with {
                            'id': 'us-modal-call',
                            'class': 'us-modal-call',
                            'title': 'Оформлення зворотнього дзінка',
                            'data': 'data-us-modal-call-rest-url="http://localhost:3000/call/"',
                            'buttons': {
                                'primary': {
                                    'text': 'Передзвоніть мені',
                                    'id': 'us-modal-call-accept-btn'
                                }
                            }
                        } %}
                    </li>
                </ol>
            </li>

            <li>
                <span>Blocks</span>
                <ol>
                    {% if blocks %}
                        {% for block in blocks %}
                            <li><a href="/blocks/{{ block }}.html"
                                   style="color: var(--unitshot-accent-pink); text-decoration: underline">{{ block }}</a>
                            </li>
                        {% endfor %}
                    {% endif %}
                </ol>
            </li>
        </ol>
    </div>
{% endblock %}

