{#                    </div>#}
{#                    <div class="ui-typo-row">#}
{#                        <span class="ui-typo-label">H2 / 36px / 400</span>#}
{#                        <p class="ui-typo-sample ui-typo-sample--h2">Заголовок другого рівня</p>#}
{#                    </div>#}
{#                    <div class="ui-typo-row">#}
{#                        <span class="ui-typo-label">H3 / 28px / 400</span>#}
{#                        <p class="ui-typo-sample ui-typo-sample--h3">Заголовок третього рівня</p>#}
{#                    </div>#}
{#                    <div class="ui-typo-row">#}
{#                        <span class="ui-typo-label">H4 / 22px / 500</span>#}
{#                        <p class="ui-typo-sample ui-typo-sample--h4">Заголовок четвертого рівня</p>#}
{#                    </div>#}
{#                    <div class="ui-typo-row">#}
{#                        <span class="ui-typo-label">Body / 16px / 400</span>#}
{#                        <p class="ui-typo-sample ui-typo-sample--body">Основний текст сторінки. Використовується для#}
{#                            параграфів та загального контенту.</p>#}
{#                    </div>#}
{#                    <div class="ui-typo-row">#}
{#                        <span class="ui-typo-label">Small / 13px / 400</span>#}
{#                        <p class="ui-typo-sample ui-typo-sample--small">Дрібний текст для підписів та допоміжної#}
{#                            інформації</p>#}
{#                    </div>#}
{#                    <div class="ui-typo-row">#}
{#                        <span class="ui-typo-label">Mono / 14px / 400</span>#}
{#                        <p class="ui-typo-sample ui-typo-sample--mono">--color-primary: #1a1a1a;</p>#}
{#                    </div>#}
{#                </div>#}
            </section>

            <section class="ui-section" id="components">
                <div class="ui-section__head">
                    <span class="ui-section__num">03</span>
                    <h2 class="ui-section__title">Компоненты</h2>
                </div>
                <ul class="ui-links-list">
                    {% for item in components %}
                        <li><a href="/components/{{ item }}">{{ item }}</a></li>
                    {% endfor %}
                </ul>
            </section>

            <section class="ui-section" id="blocks">
                <div class="ui-section__head">
                    <span class="ui-section__num">04</span>
                    <h2 class="ui-section__title">Блоки</h2>
                </div>
                <ul class="ui-links-list">
                    {% for item in blocks %}
                        <li><a href="/blocks/{{ item }}">{{ item }}</a></li>
                    {% endfor %}
                </ul>
            </section>

            <section class="ui-section" id="pages">
                <div class="ui-section__head">
                    <span class="ui-section__num">05</span>
                    <h2 class="ui-section__title">Страницы</h2>
                </div>
                <ul class="ui-links-list">
                    {% for item in pages %}
                        <li><a href="/pages/{{ item }}">{{ item }}</a></li>
                    {% endfor %}
                </ul>
            </section>

        </div>
    </div>

    <script>
        (function () {
            const kit = document.querySelector('.ui-kit');
            const sidebar = document.getElementById('uiSidebar');
            const toggleBtn = document.getElementById('uiSidebarToggle');
            const isMobile = function () { return window.innerWidth <= 768; };

            // Desktop: сворачивание сайдбара
            if (toggleBtn) {
                toggleBtn.addEventListener('click', function () {
                    kit.classList.toggle('sidebar-collapsed');
                });
            }

            function closeSidebar() {
                sidebar.classList.remove('is-open');
            }


            // Закрытие по клику на ссылку (мобилка)
            sidebar.querySelectorAll('.ui-sidebar__link').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (isMobile()) closeSidebar();
                });
            });
        })();
    </script>
{% endblock %}
