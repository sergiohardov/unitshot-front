{% extends '@layouts/demo.twig' %}

{% block content %}
    <style>
        /* inner numeric list */
        ol {
            list-style-type: none;
            counter-reset: item;
            margin: 0;
            padding: 0;
        }
        ol > li {
            counter-increment: item;
            margin-bottom: 0.6em;
            padding: 10px 0;
        }
        ol > li:before {
            content: counters(item, ".") ". ";
            padding-right: 0.6em;
        }
        li ol > li {
            margin: 0;
        }
        li ol > li:before {
            content: counters(item, ".") " ";
        }

        .ui-title {
            margin-bottom: 10px;
            font-size: 20px;
        }
        .ui-content {
            margin-top: 10px;
        }
    </style>

    <div class="us-container" style="padding-top: 20px; pbd-bottom: 20px;">
