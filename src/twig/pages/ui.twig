{% extends '@layouts/demo.twig' %}

{% block content %}
    <style>
        /* inner numeric list */
        ol {
            list-style-type: none;
            counter-reset: item;
            margin: 0;
            padding: 0;
        }
        ol > li {
            counter-increment: item;
            margin-bottom: 0.6em;
            padding: 10px 0;
        }
        ol > li:before {
            content: counters(item, ".") ". ";
            padding-right: 0.6em;
        }
        li ol > li {
            margin: 0;
        }
        li ol > li:before {
            content: counters(item, ".") " ";
        }

        .ui-title {
            margin-bottom: 10px;
            font-size: 20px;
        }
        .ui-content {
            margin-top: 10px;
        }
    </style>

    <div class="us-container" style="padding-top: 20px; pbd-bottom: 20px;">
        <ol>
            <li>
                <span class="ui-title">Colors</span>
                <div class="ui-content" style="color: black; text-shadow: 0 0 5px white;">
                    {% for item in colors %}
                        <div style="background-color: var({{ item.name }});">{{ item.name }}: {{ item.hex }};</div>
                    {% endfor %}
                </div>
            </li>

            <li>
                <span class="ui-title">Classes</span>
                <ol>
                    <li>
                        <span class="ui-title">Container: .us-container</span>
                        <div class="ui-content">
                            <div class="us-container">
                                <div style="display: flex; align-items:center; justify-content: center; height: 50px; background-color: var(--unitshot-accent-pink); margin: 0 -15px;">
                                    <p>1290px/auto</p>
                                </div>
                            </div>
                        </div>
                    </li>

                    <li>
                        <span class="ui-title">Title: .us-title-h1;.us-title-h2</span>
                        <div class="ui-content">
                            <h1 class="us-title-h1">h1 Example</h1>
                            <h2 class="us-title-h2">h2 Example</h2>
                        </div>
                    </li>
                </ol>
            </li>

            <li>
                <span class="ui-title">Components</span>
                <ol>
                    {% if components %}
                        {% for component in components %}
                            <li><a href="/components/{{ component }}.html" style="color: var(--unitshot-accent-pink); text-decoration: underline">{{ component }}</a></li>
                        {% endfor %}
                    {% endif %}


                    <li>
                        <span class="ui-title">Modals</span>
                        <div class="ui-content" style="display: flex; gap: 10px; flex-wrap: wrap;">
                            {% include '@components/button-square.twig' with {
                                'version': 'v2',
                                'text': 'Modal Add Cart',
                                'data': 'data-us-modal-id="us-modal-add-cart"'
                            } %}
                            {% include '@components/button-square.twig' with {
                                'version': 'v2',
                                'text': 'Modal Remove Cart',
                                'data': 'data-us-modal-id="us-modal-remove-cart"'
                            } %}
                            {% include '@components/button-square.twig' with {
                                'version': 'v2',
                                'text': 'Modal Lang',
                                'data': 'data-us-modal-id="us-modal-lang"'
                            } %}
                            {% include '@components/button-square.twig' with {
                                'version': 'v2',
                                'text': 'Modal Call',
                                'data': 'data-us-modal-id="us-modal-call"'
                            } %}
                        </div>
                        {% include '@components/modal-add-cart.twig' with {
                            'id': 'us-modal-add-cart',
                            'class': 'us-modal-add-cart',
                            'title': 'Товар додано до кошика',
                        } %}

                        {% include '@components/modal-remove-cart.twig' with {
                            'id': 'us-modal-remove-cart',
                            'class': 'us-modal-remove-cart',
                            'title': 'Товар видалено з кошика',
                        } %}

                        {% include '@components/modal-lang.twig' with {
                            'id': 'us-modal-lang',
                            'class': 'us-modal-lang',
                            'title': 'Чи бажаєте переглядати сайт українською мовою?',
                            'buttons': {
                                'secondary': {
                                    'text': 'Ні',
                                },
                                'primary': {
                                    'text': 'Так',
                                }
                            }
                        } %}

                        {% include '@components/modal-call.twig' with {
                            'id': 'us-modal-call',
                            'class': 'us-modal-call',
                            'title': 'Оформлення зворотнього дзінка',
                            'data': 'data-us-modal-call-rest-url="http://localhost:3000/call/"',
                            'buttons': {
                                'primary': {
                                    'text': 'Передзвоніть мені',
                                    'id': 'us-modal-call-accept-btn'
                                }
                            }
                        } %}
                    </li>
                </ol>
            </li>
            <li>
                <span class="ui-title">Blocks</span>
                <ol>
                    {% if blocks %}
                        {% for block in blocks %}
                            <li><a href="/blocks/{{ block }}.html" style="color: var(--unitshot-accent-pink); text-decoration: underline">{{ block }}</a></li>
                        {% endfor %}
                    {% endif %}
                </ol>
            </li>
        </ol>
    </div>
{% endblock %}

