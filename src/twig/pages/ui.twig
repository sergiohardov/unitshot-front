{% extends '@layouts/demo.twig' %}

{% block content %}
    <style>
        /* inner numeric list */
        ol {
            list-style-type: none;
            counter-reset: item;
            margin: 0;
            padding: 0;
        }
        ol > li {
            counter-increment: item;
            margin-bottom: 0.6em;
            padding: 10px 0;
        }
        ol > li:before {
            content: counters(item, ".") ". ";
            padding-right: 0.6em;
        }
        li ol > li {
            margin: 0;
        }
        li ol > li:before {
            content: counters(item, ".") " ";
        }

        .ui-title {
            margin-bottom: 10px;
            font-size: 20px;
        }
        .ui-content {
            margin-top: 10px;
        }
    </style>

    <div class="us-container" style="padding-top: 20px; pbd-bottom: 20px;">
        <ol>
            <li>
                <span class="ui-title">Colors</span>
                <div class="ui-content" style="color: black; text-shadow: 0 0 5px white;">
                    <div style="background-color: var(--unitshot-white);">--unitshot-white: #FFFFFF;</div>
                    <div style="background-color: var(--unitshot-black);">--unitshot-black: #000000;</div>
                    <div style="background-color: var(--unitshot-gray-main);">--unitshot-gray-main: #393939;</div>
                    <div style="background-color: var(--unitshot-gray-light);">--unitshot-gray-light: #F5F5F5;</div>
                    <div style="background-color: var(--unitshot-gray-dark);">--unitshot-gray-dark: #9D9D9D;</div>
                    <div style="background-color: var(--unitshot-gray-darker);">--unitshot-gray-darker: #CFCFCF;</div>
                    <div style="background-color: var(--unitshot-accent-pink);">--unitshot-accent-pink: #ED81B5;</div>
                </div>
            </li>

            <li>
                <span class="ui-title">Classes</span>
                <ol>
                    <li>
                        <span class="ui-title">Container: .us-container</span>
                        <div class="ui-content">
                            <div class="us-container">
                                <div style="display: flex; align-items:center; justify-content: center; height: 50px; background-color: var(--unitshot-accent-pink); margin: 0 -15px;">
                                    <p>1290px/auto</p>
                                </div>
                            </div>
                        </div>
                    </li>

                    <li>
                        <span class="ui-title">Title: .us-title-h1;.us-title-h2</span>
                        <div class="ui-content">
                            <h1 class="us-title-h1">h1 Example</h1>
                            <h2 class="us-title-h2">h2 Example</h2>
                        </div>
                    </li>
                </ol>
            </li>

            <li>
                <span class="ui-title">Components</span>
                <ol>
                    <li>
                        <span class="ui-title">Checkbox</span>
                        <div class="ui-content">
                            <div style="display: flex; gap: 10px; align-items: flex-start;">
                                {% include '@components/checkbox.twig' with {
                                    'label': 'Підкатегорія 1',
                                    'id': 'check-1'
                                } %}
                                {% include '@components/checkbox.twig' with {
                                    'label': 'Підкатегорія 2',
                                    'id': 'check-2'
                                } %}
                            </div>
                        </div>
                    </li>

                    <li>
                        <span class="ui-title">Button Square</span>
                        <div class="ui-content">
                            <h3>Type: Button</h3>
                            <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-start;">
                                {% include '@components/button-square.twig' with {
                                    'version': 'v1',
                                    'text': 'Перейти',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v2',
                                    'text': 'Перейти',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v3',
                                    'text': 'Перейти',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v4',
                                    'text': 'Перейти',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v5',
                                    'text': '220v',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v6',
                                    'text': '220v',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v7',
                                    'text': '220v',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v5',
                                    'text': '220v',
                                    'disabled': true
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v5',
                                    'text': '1',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v6',
                                    'text': '1',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v7',
                                    'text': '1',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v5',
                                    'text': '1',
                                    'disabled': true
                                } %}
                            </div>
                            <h3>Type: Link</h3>
                            <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: flex-start;">
                                {% include '@components/button-square.twig' with {
                                    'version': 'v1',
                                    'type': 'link',
                                    'text': 'Перейти',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v2',
                                    'type': 'link',
                                    'text': 'Перейти',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v3',
                                    'type': 'link',
                                    'text': 'Перейти',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'version': 'v4',
                                    'type': 'link',
                                    'text': 'Перейти',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'type': 'link',
                                    'version': 'v5',
                                    'text': '220v',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'type': 'link',
                                    'version': 'v6',
                                    'text': '220v',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'type': 'link',
                                    'version': 'v7',
                                    'text': '220v',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'type': 'link',
                                    'version': 'v5',
                                    'text': '220v',
                                    'disabled': true
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'type': 'link',
                                    'version': 'v5',
                                    'text': '1',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'type': 'link',
                                    'version': 'v6',
                                    'text': '1',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'type': 'link',
                                    'version': 'v7',
                                    'text': '1',
                                } %}
                                {% include '@components/button-square.twig' with {
                                    'type': 'link',
                                    'version': 'v5',
                                    'text': '1',
                                    'disabled': true
                                } %}
                            </div>
                        </div>
                    </li>

                    <li>
                        <span class="ui-title">Button Round</span>
                        <div class="ui-content">
                            <div style="display: flex; gap: 10px; align-items: flex-start;">
                                {% include '@components/button-round.twig' with {
                                    'version': 'v1',
                                } %}
                                {% include '@components/button-round.twig' with {
                                    'version': 'v2',
                                } %}
                                {% include '@components/button-round.twig' with {
                                    'version': 'v3',
                                    'text': '1'
                                } %}
                                {% include '@components/button-round.twig' with {
                                    'version': 'v4',
                                    'text': '1'
                                } %}
                                {% include '@components/button-round.twig' with {
                                    'version': 'v5',
                                    'text': '1'
                                } %}
                            </div>
                        </div>
                    </li>

                    <li>
                        <span class="ui-title">Button Arrow</span>
                        <div class="ui-content">
                            <div style="display: flex; gap: 10px; align-items: flex-start;">
                                {% include '@components/button-arrow.twig' with {
                                    'version': 'v1',
                                } %}

                                {% include '@components/button-arrow.twig' with {
                                    'version': 'v2',
                                } %}

                                {% include '@components/button-arrow.twig' with {
                                    'version': 'v3',
                                } %}
                            </div>
                        </div>
                    </li>

                    <li>
                        <span class="ui-title">Breadcrumbs</span>
                        <div class="ui-content">
                            {% include '@components/breadcrumbs.twig' with {
                                'links': [
                                    {'src': '#', 'title': 'Головна', 'is_current': false},
                                    {'src': '#', 'title': 'Головна', 'is_current': false},
                                    {'src': '#', 'title': 'Головна', 'is_current': false},
                                    {'src': '#', 'title': 'Кавомашини', 'is_current': true},
                                ],
                            } %}
                        </div>
                    </li>

                    <li>
                        <span class="ui-title">Pagination</span>
                        <div class="ui-content">
                            {% include '@components/pagination.twig' with {
                                'prev': '#prev',
                                'next': '#next',
                                'pages': [
                                    {'number': 1, 'link': '#1', 'is_current': true},
                                    {'number': 2, 'link': '#2', 'is_current': false},
                                    {'number': 3, 'link': '#3', 'is_current': false},
                                    {'number': 4, 'link': '#4', 'is_current': false},
                                ]
                            } %}
                        </div>
                    </li>

                    <li>
                        <span class="ui-title">Phone Number</span>
                        <div class="ui-content">
                            {% include '@components/phone-number.twig' with {
                                'number': '+380731111111',
                            } %}
                            {% include '@components/phone-number.twig' with {
                                'number': '+380732222222',
                            } %}
                        </div>
                    </li>
            <li>
                <span class="ui-title">Blocks</span>
                <ol>
                    <li>
                        <span class="ui-title">Footer</span>
                        <div class="ui-content">
                            {% include '@blocks/footer.twig' with {
                                'home_url': '/home.html',
                                'logo': {
                                    'src': '/src/images/pictures/logo.png',
                                    'alt': 'Site Logo'
                                },
                                'menu_1': {
                                    'title': 'Каталог',
                                    'menu': [
                                        {'link': '#', 'title': 'Кавомашини'},
                                        {'link': '#', 'title': 'Кавомолки'},
                                        {'link': '#', 'title': 'Водопідготовка'},
                                        {'link': '#', 'title': 'Інструменти бариста'},
                                        {'link': '#', 'title': 'Термопоти'},
                                        {'link': '#', 'title': 'Комплекти'},
                                        {'link': '#', 'title': 'Вживане обладнання'},
                                        {'link': '#', 'title': 'Сервіс'},
                                    ]
                                },
                                'menu_2': {
                                    'title': 'Інформація',
                                    'menu': [
                                        {'link': '#', 'title': 'Доставка та оплата'},
                                        {'link': '#', 'title': 'Про нас'},
                                        {'link': '#', 'title': 'Гарантія'},
                                        {'link': '#', 'title': 'Політика конфіденційності'},
                                        {'link': '#', 'title': 'Публічна оферта'},
                                        {'link': '#', 'title': 'Мапа сайту'},
                                    ]
                                },
                                'contact_title': 'Контактна інформація',
                                'numbers': ['380731111111', '380732222222'],
                                'socials': [
                                    {'link': '#', 'icon': {'src': '/src/images/icons/social-telegram.svg', 'alt': 'telegram'}},
                                    {'link': '#', 'icon': {'src': '/src/images/icons/social-viber.svg', 'alt': 'telegram'}},
                                    {'link': '#', 'icon': {'src': '/src/images/icons/social-whatsapp.svg', 'alt': 'telegram'}},
                                    {'link': '#', 'icon': {'src': '/src/images/icons/social-instagram.svg', 'alt': 'telegram'}},
                                    {'link': '#', 'icon': {'src': '/src/images/icons/social-tiktok.svg', 'alt': 'telegram'}},
                                ],
                                'email': 'admin@mail.com',
                                'address': 'м.Дніпро вул. Центральна 2А'
                            } %}
                        </div>
                    </li>
                </ol>
            </li>
        </ol>
    </div>
{% endblock %}

