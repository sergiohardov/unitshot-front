{% extends '@layouts/base.twig' %}

{% block content %}
    <div class="us-page-catalog">
        <div class="us-container">
            <div class="us-page-catalog__inner">
                {% include '@components/breadcrumbs.twig' with {
                    'links': breadcrumbs,
                    'class': 'us-page-catalog__breadcrumbs'
                } %}

                {% include '@components/page-title.twig' with {
                    'class': 'us-page-catalog__title',
                    'title': title,
                    'tag': 'h1'
                } %}

                {% include '@components/slider-categories.twig' with {
                    'categories': categories
                } %}

                <div class="us-page-catalog__buttons">
                    {% include '@components/button-square.twig' with {
                        'class': 'us-page-catalog__buttons__filter-btn',
                        'version': 'v2',
                        'data': 'data-us-modal-id="us-modal-filter"',
                        'text': 'Фільтр',
                    } %}

                    <div class="us-page-catalog__buttons__sort">
                        {% include '@components/button-square.twig' with {
                            'class': 'us-page-catalog__buttons__sort-btn',
                            'version': 'v2',
                            'text': 'Сортувати',
                        } %}

                        <div class="us-page-catalog__buttons__sort-dropdown">
                            <span>За замовчуванням</span>
                            <span>Від більшого до меншого</span>
                            <span>За замовчуванням</span>
                        </div>
                    </div>

                </div>

                {% if products %}
                    <div class="us-page-catalog__products">
                        {% for product in products %}
                            {% include '@components/product-card.twig' with {
                                'tags': product.tags,
                                'image': product.image,
                                'title': product.title,
                                'brand': product.brand,
                                'category': product.category,
                                'price': product.price,
                            } %}
                        {% endfor %}
                    </div>
                {% endif %}

                {% include '@components/pagination.twig' with {
                    'class': 'us-page-catalog__pagination',
                    'prev': pagination.prev,
                    'next': pagination.next,
                    'pages': pagination.pages
                } %}

                {% include '@blocks/feedback-info.twig' with {
                    'class': 'us-page-catalog__feedback-info',
                    'title': feedback_info.title,
                    'description': feedback_info.description,
                    'socials': feedback_info.socials
                } %}

                {% include '@blocks/text-image.twig' with {
                    'title': text_image.title,
                    'description': text_image.description,
                    'image': text_image.image,
                    'hide_text': text_image.hide_text,
                } %}
            </div>
        </div>

        {% include '@components/modal-filter.twig' with {
            'id': 'us-modal-filter',
            'class': 'us-modal-filter',
            'title': 'Фільтр',
            'modify': 'left',
            'buttons': null,
            'filters': filters,
        } %}
    </div>
{% endblock %}
