{% if text %}
    {% if type == 'link' %}
        <a href="{{ href }}" class="us-button-v1 {% if modify %} us-button-v1--{{ modify }} {% endif %} {% if disabled %} us-button-v1--link-disabled {% endif %}">
            {{ text }}
        </a>
    {% else %}
        <button class="us-button-v1 {% if modify %} us-button-v1--{{ modify }} {% endif %}" {% if disabled %} disabled {% endif %}>
            {{ text }}
        </button>
    {% endif %}
{% endif %}
