{% extends '@layouts/slider.twig' %}

{% set class = 'us-slider-logo-images' %}
{% set swiper_options = {
    "loop": true,
    "slidesPerView": 3,
    "spaceBetween": 20,
    "breakpoints": {
        769: { "slidesPerView": 5 },
        993: { "slidesPerView": 7 }
    }
} %}

{% block slides %}
    {% for logo in logotypes %}
        <div class="swiper-slide">
            <a class="us-slider-logo-images__link" href="{{ logo.link }}">
                <img class="us-slider-logo-images__img" src="{{ logo.image.src }}" alt="{{ logo.image.alt }}">
            </a>
        </div>
    {% endfor %}
{% endblock %}
